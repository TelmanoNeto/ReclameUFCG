# Copie este arquivo para `.env.local` (que o .gitignore já ignora, por causa
# do padrão `*.local`) e preencha com as chaves do seu projeto.
#
# As chaves do Firebase no frontend são públicas por natureza — quem protege os
# dados são as Security Rules, não o segredo da chave. Ainda assim, não commitar.
#
# Onde achar cada uma: console do Firebase → ⚙ Configurações do projeto →
# Seus apps → app da Web → "Configuração do SDK".

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary → Settings → Upload → Upload presets → adicionar um preset
# com Signing Mode = "Unsigned".
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
